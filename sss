<#
.SYNOPSIS
    Collects ESXi host physical NIC inventory and management / data uplink topology information.

.DESCRIPTION
    This script inventories ESXi host physical network adapters (pNICs) and maps them to
    standard vSwitches and distributed vSwitch uplinks. The primary goal is to model
    hardware-to-logical cabling relationships in a reliable and deterministic manner.

    Management and data network roles are derived from ESXi VMkernel configuration,
    rather than from switch naming conventions or default assumptions.

    Specifically:
      - Management networks are identified exclusively by VMkernel adapters with
        ManagementTrafficEnabled = True.
      - Port Groups and vSwitches are treated as downstream topology representations,
        not as sources of truth.
      - No assumptions are made about vSwitch names (e.g. vSwitch0) or Port Group names
        (e.g. "Management Network").

    Physical NIC numbering and CSV output are designed to be stable, readable, and
    future-proof:
      - vmnic* interfaces are always prioritized.
      - Non-vmnic adapters (e.g. vusb, pseudo interfaces) are ordered after vmnic devices.
      - Ordering rules are consistent for both Management (MGT) and Data (DATA) entries.

    NIC port speed classification is derived from ValidLinkSpecification, which represents
    ESXi-detected hardware link capabilities (supported speed and duplex combinations).
    Runtime link state (LinkSpeed) is intentionally excluded to avoid misinterpretation
    caused by cabling issues, transceiver negotiation, or temporary link conditions.

    This design clearly separates:
      - Hardware capability (what the NIC can support)
      - Logical usage (how the NIC is consumed by vSwitch / dvSwitch uplinks)

.FEATURES
    - Supports both vCenter-managed and direct ESXi host connections
    - Handles standard vSwitch and distributed vSwitch environments
    - Correctly identifies Management networks based on VMkernel facts
    - Deduplicates distributed vSwitch uplinks safely
    - Produces normalized and stable CSV output for inventory and cabling analysis
    - Consistent NIC numbering for both Management (MGT) and Data (DATA) paths
    - Supports modern NIC speeds (FE / GE / 10G / 25G / 40G / 100G)

.DESIGN PRINCIPLES
    - VMkernel configuration is the single source of truth for management networks
    - No reliance on default object names or historical assumptions
    - Deterministic output suitable for audits, documentation, and capacity planning
    - Defensive handling of non-standard or future NIC interface types

.LIMITATIONS
    - Does not rely on runtime link state or operational traffic status
    - Does not attempt to infer cable media type (copper / fiber)
    - Does not make vendor- or driver-specific assumptions
    - Reports UNKNOWN only when ESXi does not expose ValidLinkSpecification

.AUTHOR
    (Internal Use)

.NOTES
    This script is intended for inventory, topology modeling, and cabling analysis.
    It is not intended to perform configuration changes or network validation tests.
#>

Clear-Host
# ============================================================
# PowerCLI initialization
# ============================================================
$env:POWERCLI_SKIP_REENTRANT_SERVER_LIST = "1"
Set-PowerCLIConfiguration -InvalidCertificateAction Ignore -Confirm:$false | Out-Null
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# ============================================================
# Failure reason constants
# ============================================================
$FAIL_UNREACHABLE = "UNREACHABLE"
$FAIL_SKIPPED_BY_USER = "SKIPPED_BY_USER"

function Read-CredentialInteractive {
    param(
        [string]$TargetName
    )

    Write-Host ""
    Write-Host ("[CREDENTIAL] Enter credentials for {0}" -f $TargetName) -ForegroundColor Yellow

    $username = Read-Host "Username"
    $password = Read-Host "Password" -AsSecureString

    if (-not $username -or -not $password) {
        return $null
    }
    return New-Object PSCredential ($username, $password)
}

# ============================================================
# vCenter connection information
# ============================================================
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "Enter vCenter Server hostname or IP (leave blank to skip vCenter): " -ForegroundColor DarkYellow -NoNewline
$vCenterServer = Read-Host
$vCenterCredential = $null

if ($vCenterServer) {
    Write-Host ""
    Write-Host "NOTE: You may be prompted to enter credentials for vCenter and/or direct ESXi access." -ForegroundColor Yellow
    Write-Host "      These credentials are required to support phased data collection and to minimize repeated authentication prompts during execution." -ForegroundColor Yellow
    $vCenterCredential = Read-CredentialInteractive "vCenter"
}

# ============================================================
# Cache ESXi Direct credential at startup (optional later use)
# ============================================================

$initialEsxiCredential = $null

$initialEsxiCredential = Read-CredentialInteractive "ESXi"

# ============================================================
# Output paths
# ============================================================
$timestamp = (Get-Date).ToString("yyyyMMdd-HHmmss")
$scriptDir = if ($PSCommandPath) { Split-Path -Parent $PSCommandPath } else { (Get-Location).Path }

$esxiListFile = Join-Path $scriptDir "ESXiHosts.txt"
$outputCsv = Join-Path $scriptDir ("Output\ESXi_Host_Inventory_{0}.csv" -f $timestamp)
$statusLog = Join-Path $scriptDir ("ESXi_Connection_Status_{0}.log" -f $timestamp)

"Hostname,Mode,Result" | Out-File $statusLog -Encoding UTF8

# ============================================================
# Read ESXi host list
# ============================================================
$esxiHostNames = Get-Content $esxiListFile |
Where-Object { $_ -and $_.Trim() -ne "" -and -not $_.Trim().StartsWith("#") } |
ForEach-Object { $_.Trim() } |
Select-Object -Unique

# ============================================================
# Start Timer
# ============================================================
Write-Host ""
Write-Host "Starting execution timing (interactive input excluded)..." -ForegroundColor Gray

$globalExecutionTimer = [System.Diagnostics.Stopwatch]::StartNew()

function Write-Status {
    param(
        [string]$HostName,
        [string]$Mode,
        [string]$Result
    )
    Add-Content -Path $statusLog -Value "$HostName,$Mode,$Result"
}

# ============================================================
# Connect to vCenter
# ============================================================

$vcConnection = $null

if ($vCenterServer) {
    Write-Host ""
    try {
        $vcConnection = Connect-VIServer `
            -Server $vCenterServer `
            -Credential $vCenterCredential `
            -ErrorAction Stop
        Write-Host ("[SUCCESS] Connected to vCenter: {0}" -f $vcConnection.Name) -ForegroundColor Green
        $script:vcDnsDomain = ($vcConnection.Name -split '\.', 2)[1]
    }
    catch {
        Write-Host ("[INFO] vCenter connection to '{0}' failed. ESXi Direct mode will be used." -f $vCenterServer
        ) -ForegroundColor DarkYellow
    }
    Write-Host "============================================================" -ForegroundColor Cyan
}
else {
    Write-Host "[INFO] vCenter address not provided. ESXi Direct mode only." -ForegroundColor DarkYellow
    Write-Host "============================================================" -ForegroundColor Cyan
}

# ============================================================
# Direct ESXi connection
# ============================================================
function Connect-EsxiDirect {
    param (
        [string]$HostName
    )

    $credential = $initialEsxiCredential

    while ($true) {

        # 如果没有凭证（首次或刚被清空），提示输入
        if (-not $credential) {
            $credential = Read-CredentialInteractive "ESXi"
            if (-not $credential) {
                Write-Host "No credential provided, skipping host." -ForegroundColor DarkYellow
                return [pscustomobject]@{
                    Success = $false
                    Reason  = $FAIL_SKIPPED_BY_USER
                }
            }
        }

        try {
            $connection = Connect-VIServer `
                -Server $HostName `
                -Credential $credential `
                -ErrorAction Stop

            $vmHost = Get-VMHost -Server $connection | Select-Object -First 1

            Write-Host "Direct connection to ESXi host successful." -ForegroundColor Cyan

            return [pscustomobject]@{
                Success = $true
                Mode    = "Direct"
                Server  = $connection
                VMHost  = $vmHost
            }
        }
        catch {
            # ===== 登录失败，进入人工决策 =====
            Write-Host "Current credential cannot log in to ESXi host: $HostName" -ForegroundColor Red

            # 暂停主计时（排除人工交互）
            $hostTimer.Stop()

            try {
                while ($true) {
                    $choice = Read-Host "Retry login? (Y = retry, N = skip)"

                    if ($choice) {
                        $choice = $choice.Trim().ToUpper()
                    }

                    if ($choice -eq "Y") {
                        # 重试：强制重新输入凭证
                        $credential = Read-CredentialInteractive "ESXi (Retry)"
                        break
                    }
                    elseif ($choice -eq "N") {
                        Write-Host ("[USER] Host skipped by user choice: {0}" -f $HostName) -ForegroundColor DarkYellow
                        return [pscustomobject]@{
                            Success = $false
                            Reason  = $FAIL_SKIPPED_BY_USER
                        }
                    }
                    else {
                        Write-Host "Invalid input. Please enter only Y or N." -ForegroundColor Yellow
                    }
                }
            }
            finally {
                # 无论是 retry 还是 return 前触发 finally
                # 确保计时器状态收敛
                if (-not $hostTimer.IsRunning) {
                    $hostTimer.Start()
                }
            }
        }
    }
}

# ============================================================
# Pre-connectivity check for ESXi host
# ============================================================
function Test-EsxiPreConnectivity {
    param(
        [string]$HostName
    )

    # ------------------------------------------------------------
    # 1. Ping check
    # ------------------------------------------------------------
    try {
        $pingOk = Test-Connection `
            -ComputerName $HostName `
            -Count 1 `
            -Quiet `
            -ErrorAction Stop

        if (-not $pingOk) {
            return "PING_FAILED"
        }
    }
    catch {
        return "PING_FAILED"
    }

    # ------------------------------------------------------------
    # 2. TCP 443 check (ESXi API / vSphere)
    # ------------------------------------------------------------
    try {
        $tcp443 = Test-NetConnection `
            -ComputerName $HostName `
            -Port 443 `
            -InformationLevel Quiet `
            -WarningAction SilentlyContinue

        if (-not $tcp443) {
            return "TCP_443_FAILED"
        }
    }
    catch {
        return "TCP_443_FAILED"
    }

    return "OK"
}

# ============================================================
# Resolve ESXi host (vCenter first, then direct)
# NOTE:
# Fast-path assumes ESXi hosts share DNS domain with vCenter.
# Slow fallback handles non-uniform environments.
# ============================================================
function Resolve-EsxiHost {
    param(
        [string]$HostName
    )

    if (-not $vcConnection) {
        return $null
    }

    # ------------------------------------------------------------
    # Fast path 1: Exact Name match
    # ------------------------------------------------------------
    $vmHost = Get-VMHost -Name $HostName -Server $vcConnection -ErrorAction SilentlyContinue
    if ($vmHost) {
        return $vmHost
    }

    # ------------------------------------------------------------
    # Fast path 2: Name + vCenter DNS domain
    # ------------------------------------------------------------
    if ($HostName -notmatch '\.' -and $script:vcDnsDomain) {
        $fqdn = "$HostName.$script:vcDnsDomain"

        $vmHost = Get-VMHost -Name $fqdn -Server $vcConnection -ErrorAction SilentlyContinue
        if ($vmHost) {
            return $vmHost
        }
    }

    # ------------------------------------------------------------
    # Slow fallback: exhaustive resolve (DNSConfig / Mgmt IP)
    # ------------------------------------------------------------
    return Resolve-ESXiFromVCenter $HostName
}

function Convert-ToCsvSafe {
    param([string[]]$Fields)
    return ($Fields | ForEach-Object {
            '"' + ($_ -replace '"', '""') + '"'
        }) -join ","
}

function Get-PnicPortType {
    param (
        [Parameter(Mandatory)]
        $Pnic
    )
    $portType = "UNKNOWN"
    if ($Pnic -and $Pnic.ExtensionData -and $Pnic.ExtensionData.ValidLinkSpecification) {
        # 取所有 Full-Duplex 的速率
        $maxSpeedMb = (
            $Pnic.ExtensionData.ValidLinkSpecification |
            Where-Object { $_.Duplex -eq $true } |
            Select-Object -ExpandProperty SpeedMb |
            Measure-Object -Maximum
        ).Maximum

        if ($maxSpeedMb) {
            switch ($maxSpeedMb) {
                { $_ -ge 100000 } { $portType = "100G"; break }
                { $_ -ge 40000 } { $portType = "40G"; break }
                { $_ -ge 25000 } { $portType = "25G"; break }
                { $_ -ge 10000 } { $portType = "TenG"; break }
                1000 { $portType = "GE"; break }
                100 { $portType = "FE"; break }
            }
        }
    }
    return $portType
}

function Resolve-ESXiFromVCenter {
    param(
        [string]$InputName
    )

    foreach ($vmHost in Get-VMHost -Server $vcConnection) {

        # ------------------------------------------------------------
        # 1. Inventory Name match (fast, server-side cached)
        # ------------------------------------------------------------
        if ($vmHost.Name -ieq $InputName) {
            return $vmHost
        }

        # ------------------------------------------------------------
        # 2. DNS / FQDN match from ESXi DNSConfig (authoritative)
        # ------------------------------------------------------------
        try {
            $dns = $vmHost.ExtensionData.Config.Network.DnsConfig
            if ($dns -and $dns.HostName) {

                $fqdn = if ($dns.DomainName) {
                    "$($dns.HostName).$($dns.DomainName)"
                }
                else {
                    $dns.HostName
                }

                if ($InputName -ieq $dns.HostName -or
                    $InputName -ieq $fqdn) {
                    return $vmHost
                }
            }
        }
        catch {
            # ignore DNSConfig access issues
        }

        # ------------------------------------------------------------
        # 3. Management IP match (ONLY when host is operable)
        # ------------------------------------------------------------
        if ($vmHost.ConnectionState -in @("Connected", "Maintenance")) {
            try {
                $vmks = Get-VMHostNetworkAdapter `
                    -VMHost $vmHost `
                    -VMKernel `
                    -ErrorAction Stop

                foreach ($vmk in $vmks) {
                    if ($vmk.ManagementTrafficEnabled -and
                        $vmk.IP -eq $InputName) {
                        return $vmHost
                    }
                }
            }
            catch {
                # ignore VMKernel access issues
            }
        }
    }

    return $null
}


# ============================================================
# CSV header
# ============================================================
$csvHeaders = @("Host", "Port", "NIC", "Bonding", "IP", "MAC", "PortType")
($csvHeaders -join ",") | Out-File -FilePath $outputCsv -Encoding UTF8

# ============================================================
# Main logic
# ============================================================

$esxiCount = $esxiHostNames.Count
$i = 0

# ============================================================
# NIC sorting definition (used by both MGT and DATA paths)
# ============================================================
$nicSortDefinition = @(
    @{ Expression = { $_.VSwitch } },
    @{ Expression = { if ($_.Pnic.Name -match '^vmnic\d+$') { 0 } else { 1 } } },
    @{ Expression = {
            if ($_.Pnic.Name -match '^vmnic(\d+)$') {
                [int]$matches[1]
            }
            else {
                [int]::MaxValue
            }
        }
    },
    @{ Expression = { $_.Pnic.Name } }
)

foreach ($inputHostName in $esxiHostNames) {
    $hostTimer = [System.Diagnostics.Stopwatch]::StartNew()

    $i++
    Write-Host ""
    Write-Host "($i/$esxiCount) Processing ESXi Host: $inputHostName" -ForegroundColor Cyan

    $hostContext = $null

    try {
        # ============================================================
        # ① FIRST: Try resolve from vCenter (NO pre-check here)
        # ============================================================
        if ($vcConnection) {
            $vmHost = Resolve-EsxiHost $inputHostName

            if ($vmHost) {
                Write-Host "Found in vCenter: $($vcConnection.Name)" -ForegroundColor Cyan

                $hostContext = [pscustomobject]@{
                    Success = $true
                    Mode    = "vCenter"
                    Server  = $vcConnection
                    VMHost  = $vmHost
                }
            }
        }

        # ============================================================
        # ② ONLY IF NOT resolved in vCenter → Pre-check + Direct
        # ============================================================
        # ② ONLY IF vCenter NOT resolved AND PreCheck OK → Direct
        if (-not $hostContext) {

            # ==== 必须先做 PreCheck ====
            $preCheckResult = Test-EsxiPreConnectivity $inputHostName
            if ($preCheckResult -ne "OK") {

                Write-Host (
                    "Host not found in vCenter and PreCheck failed ({0}). Skip Direct by design." `
                        -f $preCheckResult
                ) -ForegroundColor DarkYellow

                Write-Status `
                    -HostName $inputHostName `
                    -Mode "PreCheck" `
                    -Result $preCheckResult

                continue
            }

            # ==== 只有在 vCenter 未命中 + PreCheck OK 时，才允许 Direct ====
            Write-Host "Host not found in vCenter, PreCheck OK → attempting Direct connection." -ForegroundColor Yellow

            $hostContext = Connect-EsxiDirect $inputHostName

            if (-not $hostContext -or -not $hostContext.Success) {
                $reason = if ($hostContext.Reason) { $hostContext.Reason } else { $FAIL_UNREACHABLE }

                Write-Host "Direct connection failed: $reason" -ForegroundColor Red

                Write-Status `
                    -HostName $inputHostName `
                    -Mode "Direct" `
                    -Result $reason

                continue
            }
        }

        # ============================================================
        # ③ At this point, VMHost is guaranteed
        # ============================================================
        $vmHost = $hostContext.VMHost

        # ------------------------------------------------------------
        # VMHost state validation (CRITICAL)
        # ------------------------------------------------------------
        
        if ($vmHost.ConnectionState -notin @("Connected", "Maintenance")) {
            Write-Host ("Host {0} is in state '{1}'. Skipping host-level network inventory." `
                    -f $vmHost.Name, $vmHost.ConnectionState) -ForegroundColor DarkYellow

            # ✅ 记录为 PARTIAL，而不是 FAILED
            Write-Status `
                -HostName $inputHostName `
                -Mode $hostContext.Mode `
                -Result "PARTIAL_$($vmHost.ConnectionState)"
            continue
        }

        $dataPnics = @()
        $mgtPnics = @()

        $vmkernelAdapters = Get-VMHostNetworkAdapter -VMHost $vmHost -VMKernel -ErrorAction SilentlyContinue
        $managementVmks = $vmkernelAdapters | Where-Object { $_.ManagementTrafficEnabled }

        $managementPortGroups = $managementVmks |
        Select-Object -ExpandProperty PortGroupName -Unique

        $standardPortGroups = Get-VirtualPortGroup -VMHost $vmHost -Standard

        $managementVSwitchNames = @()
        foreach ($pgName in $managementPortGroups) {
            $pg = $standardPortGroups | Where-Object { $_.Name -eq $pgName } | Select-Object -First 1
            if ($pg) { $managementVSwitchNames += $pg.VirtualSwitchName }
        }
        $managementVSwitchNames = $managementVSwitchNames | Select-Object -Unique

        # --- Map vSwitch → Management IP ---
        $vSwitchIpMap = @{}
        foreach ($vmk in $managementVmks) {
            if ($vmk.IP) {
                $pg = $standardPortGroups |
                Where-Object { $_.Name -eq $vmk.PortGroupName } |
                Select-Object -First 1
                if ($pg) { $vSwitchIpMap[$pg.VirtualSwitchName] = $vmk.IP }
            }
        }

        $standardVSwitches = Get-VirtualSwitch -VMHost $vmHost -Standard
        $physicalNics = Get-VMHostNetworkAdapter -VMHost $vmHost -Physical
        

        foreach ($vSwitch in $standardVSwitches) {
            foreach ($pnic in $physicalNics | Where-Object { $vSwitch.Nic -contains $_.Name }) {

                $entry = [pscustomobject]@{
                    Host    = $inputHostName
                    Pnic    = $pnic
                    VSwitch = $vSwitch.Name
                    IP      = $vSwitchIpMap[$vSwitch.Name]
                }

                if ($managementVSwitchNames -contains $vSwitch.Name) {
                    $mgtPnics += $entry
                }
                else {
                    $dataPnics += $entry
                }
            }
        }

        # ============================================================
        # dvSwitch handling (unchanged logic)
        # ============================================================
        try {
            $dvSwitches = Get-VDSwitch -VMHost $vmHost
        }
        catch {
            $dvSwitches = @()
        }

        foreach ($dvSwitch in $dvSwitches) {
            $seenVmnic = @{}

            foreach ($uplinkPg in Get-VDPortgroup -VDSwitch $dvSwitch | Where-Object { $_.IsUplink }) {
                $dvPorts = Get-VDPort -VDPortgroup $uplinkPg -ErrorAction SilentlyContinue |
                Where-Object { $_.ConnectedEntity -and $_.ConnectedEntity.ExtensionData.Device }

                foreach ($dvPort in $dvPorts) {
                    $vmnicName = $dvPort.ConnectedEntity.ExtensionData.Device
                    if ($seenVmnic[$vmnicName]) { continue }
                    $seenVmnic[$vmnicName] = $true

                    $pnic = $physicalNics | Where-Object { $_.Name -eq $vmnicName } | Select-Object -First 1
                    if (-not $pnic) { continue }

                    if (($mgtPnics + $dataPnics) | Where-Object { $_.Pnic.Name -eq $pnic.Name }) { continue }

                    $dataPnics += [pscustomobject]@{
                        Host    = $inputHostName
                        Pnic    = $pnic
                        VSwitch = $dvSwitch.Name
                        IP      = ""
                    }
                }
            }
        }

        # ============================================================
        # CSV output (DATA + MGT)
        # ============================================================
        $dataIndex = 0
        foreach ($entry in $dataPnics | Sort-Object $nicSortDefinition) {
            $dataIndex++
            Convert-ToCsvSafe @(
                $entry.Host,
                "DATA$dataIndex",
                $entry.Pnic.Name,
                $entry.VSwitch,
                $entry.IP,
                $entry.Pnic.Mac,
                (Get-PnicPortType -Pnic $entry.Pnic)
            ) | Out-File $outputCsv -Append -Encoding UTF8
        }

        $mgtIndex = 0
        foreach ($entry in $mgtPnics | Sort-Object $nicSortDefinition) {
            $mgtIndex++
            Convert-ToCsvSafe @(
                $entry.Host,
                "MGT$mgtIndex",
                $entry.Pnic.Name,
                $entry.VSwitch,
                $entry.IP,
                $entry.Pnic.Mac,
                (Get-PnicPortType -Pnic $entry.Pnic)
            ) | Out-File $outputCsv -Append -Encoding UTF8
        }

        if ($hostContext.Mode -eq "Direct") {
            Disconnect-VIServer $hostContext.Server -Confirm:$false | Out-Null
        }

        $hostTimer.Stop()

        # 计算一个人类可读的时间字符串
        $elapsedText = if ($hostTimer.Elapsed.TotalSeconds -ge 1) {
            "{0:N1}s" -f $hostTimer.Elapsed.TotalSeconds
        }
        else {
            "{0:N0}ms" -f $hostTimer.Elapsed.TotalMilliseconds
        }

        $color = if ($hostTimer.Elapsed.TotalSeconds -gt 10) {
            'Red'
        }
        else {
            'Green'
        }

        Write-Host (
            "[DONE] {0} (Elapsed: {1})" -f $inputHostName, $elapsedText
        ) -ForegroundColor $color

        # 记录每台 Host 的耗时（毫秒）
        Write-Status `
            -HostName $inputHostName `
            -Mode $hostContext.Mode `
            -Result ("ElapsedMs={0}" -f $hostTimer.ElapsedMilliseconds)

    }
    finally {
        Write-Host ""
        Write-Host "============================================================" -ForegroundColor Cyan
    }
}

# Stop Timer
$globalExecutionTimer.Stop()

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan

Write-Host (
    "Total execution time (excluding interaction): {0:N2} seconds" -f
    $globalExecutionTimer.Elapsed.TotalSeconds
) -ForegroundColor Green

$avgMs = $globalExecutionTimer.Elapsed.TotalMilliseconds / $esxiHostNames.Count

Write-Host (
    "Average per-host execution time: {0:N0} ms" -f
    $avgMs
) -ForegroundColor Green

Invoke-Item $outputCsv

Write-Host ""
if ($Host.Name -eq 'ConsoleHost') {
    Write-Host "Script execution completed. Press any key to exit..."
    [System.Console]::ReadKey($true) | Out-Null
}
